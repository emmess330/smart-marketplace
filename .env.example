# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=marketplace
DB_USER=marketplace_user
DB_PASSWORD=marketplace_pass
DB_URL=postgresql://marketplace_user:marketplace_pass@127.0.0.1:5432/marketplace

# Elasticsearch
ES_HOST=http://localhost:9200
# Operator key for admin endpoints (search reindex, recommender retrain),
# sent as the X-Admin-Key header.
# Generate one with: openssl rand -hex 32
ADMIN_KEY=

# Auth
JWT_SECRET=your-super-secret-key-change-this
JWT_EXPIRES_IN=7d
# Optional auth rate limits (defaults shown). Counted in memory per auth
# service instance.
# RATE_LIMIT_LOGIN_FAILURES=5      # failed logins per email+IP / 15 min
# RATE_LIMIT_LOGIN_PER_IP=100      # login attempts per IP / 15 min
# RATE_LIMIT_REGISTER_PER_IP=20    # registrations per IP / hour
# RATE_LIMIT_REFRESH_PER_IP=60     # token refreshes per IP / minute

# Stripe (sandbox)
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# App
PORT=8000
NODE_ENV=development